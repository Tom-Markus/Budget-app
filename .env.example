# Tom's Cabinet — Variables d'environnement
# Copie ce fichier en `.env.local` et remplis les valeurs.
# `.env.local` est gitignored : il ne sera jamais poussé sur GitHub.

# Client (préfixe VITE_ = exposé au navigateur — jamais de secret ici)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Serveur uniquement (fonctions Vercel /api — jamais exposé au client)
ALPHA_VANTAGE_KEY=
