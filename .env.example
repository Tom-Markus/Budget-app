# Tom's Cabinet — Variables d'environnement
# Copie ce fichier en `.env.local` et remplis les valeurs.
# `.env.local` est gitignored : il ne sera jamais poussé sur GitHub.

# Client (préfixe VITE_ = exposé au navigateur — jamais de secret ici)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Serveur uniquement (fonctions Vercel /api — jamais exposé au client)
ALPHA_VANTAGE_KEY=

# Cron des versements automatiques d'épargne (/api/cron-recurrences)
# SUPABASE_SERVICE_ROLE_KEY : Supabase → Settings → API → service_role.
#   ⚠️ Contourne la RLS — à mettre UNIQUEMENT dans les env vars Vercel.
# CRON_SECRET : chaîne aléatoire ; Vercel l'envoie automatiquement sur les
#   crons et l'endpoint refuse tout appel sans elle.
SUPABASE_SERVICE_ROLE_KEY=
CRON_SECRET=
